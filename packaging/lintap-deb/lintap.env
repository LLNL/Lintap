# Environment overrides for the Lintap systemd service.
# This file is sourced by systemd, not a shell; use KEY=VALUE assignments.

# Root for Lintap logs, parquet, raw_sensor output, and runtime state.
WINTAP_DATA_ROOT=/var/log/lintap

# Managed pidstat collector defaults. The collector reads the same environment
# file as the sensor service.
PIDSTAT_INTERVAL_SEC=5
PIDSTAT_ROTATE_INTERVAL_SEC=300
PIDSTAT_MIN_ROTATE_INTERVAL_SEC=300
PIDSTAT_DUCKDB_THREADS=1
PIDSTAT_MAX_UNSHIPPED_BYTES=1073741824
PIDSTAT_MAX_UNSHIPPED_AGE_SEC=0
PIDSTAT_VENV_DIR=/opt/lintap/pidstat-collector/.venv
PIDSTAT_BOOTSTRAP_PYTHON=3.12

# Optional .NET runtime tuning. Uncomment if needed.
# DOTNET_GCHeapHardLimit=
# DOTNET_EnableDiagnostics=0
