# Environment overrides for the Lintap systemd service.
# This file is sourced by systemd, not a shell; use KEY=VALUE assignments.

# Root for Lintap logs, parquet, raw_sensor output, and runtime state.
WINTAP_DATA_ROOT=/var/log/lintap

# Optional .NET runtime tuning. Uncomment if needed.
# DOTNET_GCHeapHardLimit=
# DOTNET_EnableDiagnostics=0
